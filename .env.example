BOT_TOKEN=
BOT_USERNAME=
ADMIN_IDS=
# Railway'da: ${{Postgres.DATABASE_URL}} havolasini qo'ying (postgresql:// yoki postgres:// bo'lsa ham bo'ladi)
# Lokal Postgres misoli:
DATABASE_URL=postgresql://postgres:parol@localhost:5432/kitobxon
# Faqat lokal sinov uchun SQLite: DATABASE_URL=sqlite+aiosqlite:///./kitobxon.db

# Railway/Render'da bot WebApp bilan bitta jarayonda ishlashi uchun true qiling
RUN_BOT=false

AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=
COINS_PER_PASSED_QUIZ=10
COINS_PER_REFERRAL_REGISTRATION=10
COINS_PER_REFERRAL_FIRST_PASSED_QUIZ=20
REFERRAL_REWARD_ON=true
REFERRAL_REWARD_AT=registration
MIN_SECONDS_PER_PAGE=30
QUIZ_QUESTION_COUNT=5
QUIZ_PASS_SCORE=4
LOG_LEVEL=INFO

# Public HTTPS address from ngrok
WEBAPP_URL=https://your-subdomain.ngrok-free.app
